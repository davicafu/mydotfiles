# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                                  GHOSTTY                                     ║
# ║                          Optimized for Neovim                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                   FONT                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

font-family = Inconsolata Nerd Font
font-size = 14


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  WINDOW                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

background-opacity = 0.95
background-blur-radius = 20

window-decoration = true
window-padding-color = extend
window-step-resize = false
window-padding-balance = true
window-height = 100
window-width = 100

gtk-tabs-location = hidden


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  SHADER                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

custom-shader = shaders/cursor_smear_gentleman.glsl


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                            INPUT / KEYBINDINGS                               │
# └──────────────────────────────────────────────────────────────────────────────┘

# Option escribe caracteres como en el resto del Mac (teclado español:
# ~ con Option+ñ, | @ # \ [ ] { } €...). Por eso no se usa como Alt.
macos-option-as-alt = false

# Excepción: Option + f/h/j/k/l se envían como Meta para los atajos de tmux
# (M-f ventana flotante, M-h/j/k/l moverse entre paneles)
keybind = alt+f=esc:f
keybind = alt+h=esc:h
keybind = alt+j=esc:j
keybind = alt+k=esc:k
keybind = alt+l=esc:l

# Option + flechas pasan tal cual a tmux (paneles y ventanas)
keybind = alt+left=unbind
keybind = alt+right=unbind

# Split Management
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down

# Split Navigation: Cmd+Option+flechas (por defecto de Ghostty). Option+h/j/k/l
# está reservado para tmux.

# Split Resize
keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10

# Miscellaneous
keybind = cmd+k=clear_screen
keybind = shift+enter=text:\x1b\r

# Open file with nvim (write 'nvim' first, then use this keybinding)
keybind = alt+s=write_screen_file:paste


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  THEME                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

# --- Base Colors ---
# Fondo casi negro: el gris (palette 8) queda a 6.2:1 de contraste
background = 06080f
foreground = f3f6f9
cursor-color = e0c15a
selection-background = 263356
selection-foreground = f3f6f9

# --- Normal Colors ---
palette = 0=#06080f
palette = 1=#ff6b6b
palette = 2=#7fd65a
palette = 3=#ffe066
palette = 4=#61afef
palette = 5=#ff8dd7
palette = 6=#5fd7d7
palette = 7=#f3f6f9

# --- Bright Colors ---
palette = 8=#8a8fa3
palette = 9=#ff9a9a
palette = 10=#a5e87b
palette = 11=#fff0a0
palette = 12=#8cc8ff
palette = 13=#ffaeea
palette = 14=#8ee8e8
palette = 15=#ffffff
